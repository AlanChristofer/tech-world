# Local defaults. Configure the same names in each cloud service without committing secrets.
SPRING_PROFILES_ACTIVE=local
MONGODB_URI=mongodb://mongodb:27017/developer_command_center
JWT_SECRET=replace-with-a-random-secret-containing-at-least-32-characters
JWT_TOKEN_TTL=PT2H
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080
PORT=8080

SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ORDER_CREATED_TOPIC=order-created
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_TRUSTSTORE_LOCATION=/app/secrets/kafka/ca.pem
KAFKA_SSL_TRUSTSTORE_TYPE=PEM

NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional until a public domain exists; enables canonical metadata, robots sitemap and sitemap URLs.
NEXT_PUBLIC_SITE_URL=
BACKEND_PORT=8080
FRONTEND_PORT=3000
